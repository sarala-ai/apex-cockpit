{
  "name": "apex-desktop",
  "productName": "APEX",
  "version": "0.1.0",
  "description": "Desktop client for the APEX cockpit",
  "author": "Sarala",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/signin.html dist/signin.html",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
