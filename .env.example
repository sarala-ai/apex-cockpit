DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---------------------------------------------------------------------------
# Observability spine (APEX-73)
# ---------------------------------------------------------------------------
# TWO separate switches, both off by default. Setting only one leaves half the
# system dark, which is why they are documented together.
#
#   OTEL_EXPORTER_OTLP_ENDPOINT — the COCKPIT SERVER's own spans.
#   APEX_OTLP_ENDPOINT          — injected into SPAWNED AGENT sessions, along
#                                 with the apex.* correlation spine as
#                                 OTEL_RESOURCE_ATTRIBUTES. For the claude
#                                 engine the launch site also sets
#                                 CLAUDE_CODE_ENABLE_TELEMETRY=1, without which
#                                 Claude Code emits nothing.
#
# Both point at an OTLP HTTP receiver; the exporter appends /v1/traces itself,
# so give the BASE url. apex-eval listens on :8000 in local dev.
#
# WHERE TO PUT THEM: the server's working directory is `server/`, not the repo
# root, so a repo-root .env is NOT read by the cwd lookup. Config is loaded from
# the paperclip INSTANCE env file (`~/.paperclip/instances/<instance>/.env`) and
# from `<cwd>/.env`. Put these in the instance env file, or export them in the
# shell that runs `pnpm dev`. This file is documentation of the vars, not a
# location the server reads.
#
# NOTE: the @opentelemetry/* packages must be installed for the server exporter
# to start; when they are missing the server logs a warning and runs untraced.
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8000
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=apex-cockpit
# APEX_OTLP_ENDPOINT=http://localhost:8000

# ─── Penpot (design previews + server-side token minting) ─────────────────────
#
# APEX_PENPOT_PASSWORD has NO default in code: a fallback dev password meant a
# misconfigured deployment silently authenticated as the compose dev account
# against whatever APEX_PENPOT_URL pointed at. Unset now = a named error, both
# for Design-tab board previews and for the secrets_provision MCP tool.
#
# APEX_PENPOT_URL=http://localhost:9001
# APEX_PENPOT_EMAIL=apex-dev@penpot.local
# APEX_PENPOT_PASSWORD=

# ─── MCP secret provisioning ──────────────────────────────────────────────────
#
# Adds the `secrets:write` capability to USER-scoped MCP sessions (the OAuth 2.1
# flow), enabling secrets_list_definitions / secrets_provision. Off by default,
# and deliberately an operator-machine decision: the OAuth flow has no consent
# screen, so nothing else asks a human before a host is allowed to mint
# credentials. Dispatched agent runs NEVER receive this capability regardless of
# this flag — mintCockpitMcpJwt strips it from every run token.
#
# PAPERCLIP_MCP_ALLOW_SECRETS_WRITE=1
